# Copy to .env in the repository root. Existing environment variables override .env.
HTTP_HOST=127.0.0.1
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kalshi_for_friends
DB_USER=kalshi_app
DB_PASSWORD=
# Use require for hosted databases such as Supabase.
DB_SSLMODE=disable
# Alternatively set DATABASE_URL; it takes priority over DB_*.
JWT_PRIVATE_KEY_FILE=private.pem
JWT_PUBLIC_KEY_FILE=public.pem
# Inline JWT_PRIVATE_KEY takes priority over the file.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
APP_ENV=development
INITIAL_BALANCE=1000
DAILY_BONUS_POINTS=1000
DAILY_BONUS_HOURS=24
PAYOUT_GRACE_MINUTES=5
# Set COOKIE_SECURE=true when the browser-facing frontend uses HTTPS.
# Browser-facing frontend origin (scheme + host + port; no page path).
FRONTEND_URL=http://localhost:3000
# Optional additional origins, comma-separated. Wildcards are not allowed.
CORS_ORIGINS=
