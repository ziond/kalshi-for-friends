# Go backend origin. /api/v1/* requests are proxied here (see next.config.ts),
# and src/proxy.ts calls $API_URL/api/v1/auth/refresh to renew expired tokens.
API_URL=http://localhost:8080

# Serve API responses from the in-memory mock (src/lib/api/mock) instead of the Go backend.
# Defaults to on; set to false once the backend is running. The route guard (src/proxy.ts)
# only runs when this is false.
NEXT_PUBLIC_API_MOCK=true

# Public key the backend signs JWTs with (EdDSA / Ed25519, SPKI PEM).
# Either point at the file (relative to frontend/)…
JWT_PUBLIC_KEY_PATH=keys/public.pem
# …or paste the PEM inline, with \n for newlines (takes priority over the path):
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----"
